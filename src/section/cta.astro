<!-- CTA Section -->
<section class="relative py-24 overflow-hidden">
  <div class="absolute inset-0 bg-cover bg-center sectionCTA"></div>
  <div
    class="absolute inset-0 bg-gradient-to-r from-slate-900/90 via-slate-900/70 to-slate-900/90"
  >
  </div>

  <div class="relative container-personalizado mx-auto px-8 text-center z-10">
    <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-6">
      ¿Listo para llevar tu inversión<br />al siguiente nivel?
    </h2>

    <p class="mt-4 text-lg text-gray-200 max-w-2xl mx-auto mb-10">
      Únete a cientos de inversionistas que ya están construyendo su patrimonio
      con Lafayette Invest. Tu futuro financiero comienza aquí.
    </p>

    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a
        href="#contacto"
        class="inline-flex items-center justify-center px-8 py-4 text-white bg-gradient-to-r from-sky-500 to-sky-600 rounded-full font-semibold hover:shadow-2xl hover:-translate-y-1 transition-all duration-300"
      >
        Agendar Consulta Gratuita
      </a>
      <a
        href="#propiedades"
        class="inline-flex items-center justify-center px-8 py-4 text-white bg-white/10 backdrop-blur-sm rounded-full font-semibold border-2 border-white/30 hover:bg-white/20 transition-all duration-300"
      >
        Ver Propiedades
      </a>
    </div>
  </div>
</section>

<style>
  .sectionCTA {
    background-image: url("../assets/img/bannerCTA.jpg");
  }
</style>
