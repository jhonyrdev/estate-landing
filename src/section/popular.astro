---
const properties = [
  {
    title: "Casa Moderna en Zona Exclusiva",
    location: "Polanco, CDMX",
    description:
      "Residencia de lujo con acabados premium y diseño contemporáneo en la zona más exclusiva.",
    rating: "4.8",
    tags: ["Lujo Premium", "Vista Exclusiva"],
    image:
      "https://images.unsplash.com/photo-1613490493576-7fde63acd811?w=800&q=80",
  },
  {
    title: "Departamento de Lujo con Vista",
    location: "Brickell, Miami",
    description:
      "Apartamento de lujo con vistas panorámicas al mar y amenidades de clase mundial.",
    rating: "4.9",
    tags: ["Vista al Mar", "Amenidades 5★"],
    image:
      "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=800&q=80",
  },
  {
    title: "Oficina Corporativa Premium",
    location: "Santa Fe, CDMX",
    description:
      "Espacio corporativo totalmente equipado en zona de negocios con excelente conectividad y servicios de primer nivel.",
    rating: "4.6",
    tags: ["Zona Corporativa", "Equipada"],
    image:
      "https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&q=80",
  },
];
---

<section class="bg-white py-15">
  <div class="container-personalizado mx-auto px-8">
    <!-- Header -->
    <div class="mb-12 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
        Propiedades <span class="text-sky-600">Destacadas</span>
      </h2>
      <p class="mt-3 text-gray-600 max-w-2xl mx-auto">
        Las opciones más buscadas con alta demanda y excelente retorno de
        inversión.
      </p>
    </div>

    <!-- Grid / Carousel -->
    <div class="relative">
      <!-- Mobile Carousel -->
      <div class="lg:hidden overflow-x-auto snap-x snap-mandatory scrollbar-hide flex gap-4 pb-4">
        {
          properties.map((property) => (
            <article class="property-card h-[30rem] sm:h-[35rem] w-full flex-shrink-0 snap-center">
              <!-- Image with overlay -->
              <div class="relative h-full">
                <img
                  src={property.image}
                  alt={property.title}
                  class="card-image"
                  loading="lazy"
                />

                <!-- Gradient overlay -->
                <div class="card-overlay"></div>

                <!-- Bookmark icon -->
                <button class="bookmark-btn">
                  <i class="fa-regular fa-bookmark text-white text-lg" />
                </button>

                <!-- Content on image -->
                <div class="card-content">
                  <!-- Title and Price -->
                  <div class="flex items-start justify-between mb-2">
                    <h3 class="card-title">
                      {property.title}
                    </h3>
                  </div>

                  <!-- Description -->
                  <p class="card-description">
                    {property.description}
                  </p>

                  <!-- Tags -->
                  <div class="flex gap-2 mb-4 flex-wrap">
                    <span class="card-tag">
                      <i class="fa-solid fa-star text-yellow-400 mr-1" />
                      {property.rating}
                    </span>
                    {property.tags.map((tag) => (
                      <span class="card-tag">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <!-- Book button -->
                  <button 
                    class="card-btn"
                    aria-label={`Ver detalles de ${property.title}`}
                    type="button"
                  >
                    Ver propiedad
                  </button>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Desktop Grid -->
      <div class="hidden lg:grid gap-8 lg:grid-cols-3">
        {
          properties.map((property) => (
            <article class="property-card h-[500px]">
              <!-- Image with overlay -->
              <div class="relative h-full">
                <img
                  src={property.image}
                  alt={property.title}
                  class="card-image"
                  loading="lazy"
                />

                <!-- Gradient overlay -->
                <div class="card-overlay"></div>

                <!-- Bookmark icon -->
                <button 
                  class="bookmark-btn"
                  aria-label={`Guardar ${property.title} en favoritos`}
                  type="button"
                >
                  <i class="fa-regular fa-bookmark text-white text-lg" aria-hidden="true" />
                </button>

                <!-- Content on image -->
                <div class="card-content">
                  <!-- Title and Price -->
                  <div class="flex items-start justify-between mb-2">
                    <h3 class="card-title">
                      {property.title}
                    </h3>
                  </div>

                  <!-- Description -->
                  <p class="card-description">
                    {property.description}
                  </p>

                  <!-- Tags -->
                  <div class="flex gap-2 mb-4 flex-wrap">
                    <span class="card-tag">
                      <i class="fa-solid fa-star text-yellow-400 mr-1" />
                      {property.rating}
                    </span>
                    {property.tags.map((tag) => (
                      <span class="card-tag">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <!-- Book button -->
                  <button 
                    class="card-btn"
                    aria-label={`Ver detalles de ${property.title}`}
                    type="button"
                  >
                    Ver propiedad
                  </button>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Carousel Indicators (Mobile only) -->
      <div class="flex justify-center gap-2 mt-6 lg:hidden" id="carousel-indicators" role="tablist" aria-label="Navegación de propiedades">
        {properties.map((property, index) => (
          <button 
            class="carousel-dot w-2 h-2 rounded-full bg-gray-300 transition-all duration-300"
            data-index={index}
            role="tab"
            aria-label={`Ir a ${property.title}`}
            aria-selected={index === 0 ? "true" : "false"}
            type="button"
          />
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-7 text-center">
      <a href="#" class="cta-btn md:rounded-full rounded-xl">
        Ver todas las propiedades
        <i class="fa-solid fa-arrow-right ml-2" />
      </a>
    </div>
  </div>
</section>

<script>
  // Carousel indicators
  const carousel = document.querySelector('.overflow-x-auto');
  const dots = document.querySelectorAll('.carousel-dot');
  
  if (carousel && dots.length > 0) {
    carousel.addEventListener('scroll', () => {
      const scrollLeft = carousel.scrollLeft;
      const cardWidth = carousel.scrollWidth / dots.length;
      const activeIndex = Math.round(scrollLeft / cardWidth);
      
      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.add('bg-sky-600', 'w-8');
          dot.classList.remove('bg-gray-300', 'w-2');
        } else {
          dot.classList.remove('bg-sky-600', 'w-8');
          dot.classList.add('bg-gray-300', 'w-2');
        }
      });
    });
    
    // Click en dots para navegar
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        const cardWidth = carousel.scrollWidth / dots.length;
        carousel.scrollTo({
          left: cardWidth * index,
          behavior: 'smooth'
        });
      });
    });
  }
</script>

<style>
  /* Cards */
  .property-card {
    position: relative;
    background: white;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    transition: all 0.5s ease;
  }

  .property-card:hover {
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .mobile-card {
    scroll-snap-align: center;
  }

  .desktop-card:hover {
    transform: translateY(-8px);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .property-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(13, 27, 42) 0%,
      rgb(13, 27, 42) 25%,
      rgba(13, 27, 42, 0.6) 50%,
      transparent 100%
    );
  }

  .bookmark-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.5rem;
    height: 2.5rem;
    background-color: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .bookmark-btn:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  .card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: bold;
    color: white;
    line-height: 1.25;
    flex: 1;
    padding-right: 0.5rem;
  }

  .card-description {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.875rem;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tag {
    display: inline-flex;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .card-btn {
    width: 100%;
    background-color: white;
    color: #111827;
    font-weight: bold;
    padding: 1rem;
    border-radius: 1rem;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .card-btn:hover {
    background-color: #f3f4f6;
    transform: scale(1.05);
  }

  /* CTA Button */
  .cta-btn {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(to right, #0ea5e9, #06b6d4);
    padding: 1rem 2rem;
    color: white;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .cta-btn:hover {
    box-shadow: 0 20px 40px rgba(14, 165, 233, 0.3);
    transform: translateY(-4px);
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</script>
