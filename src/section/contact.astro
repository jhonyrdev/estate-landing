---
const contactInfo = [
  {
    icon: "fa-envelope",
    value: "contacto@eliteHome.com",
    link: "mailto:contacto@eliteHome.com",
  },
  {
    icon: "fa-phone",
    value: "+51 949809184",
    link: "tel:+51949809184",
  },
  {
    icon: "fa-location-dot",
    value: "Av. Brasi 1100, Lima, Peru",
    link: "https://maps.google.com",
  },
  {
    icon: "fa-clock",
    value: "Lun - Vie: 9:00 AM - 6:00 PM",
    link: null,
  },
];
---

<section id="contacto" class="py-20 bg-sky-50/90">
  <div class="container-personalizado mx-auto px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Hablemos de tu <span class="text-sky-600">inversión</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Estamos aquí para responder tus preguntas y ayudarte a dar el siguiente
        paso
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 xs:max-w-[400px] items-start">
      <!-- Contact Form -->
      <div
        class="bg-white rounded-xl md:rounded-3xl shadow-xl p-4 sm:p-6 md:p-8 border border-gray-100"
      >
        <h3 class="text-2xl font-bold text-gray-900 mb-6">
          Envíanos un mensaje
        </h3>

        <form
          id="contact-form"
          class="space-y-6 xs:max-w-0"
          role="form"
          aria-label="Formulario de contacto para EliteHome Invest"
        >
          <!-- Grid para Name y Email -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Name -->
            <div>
              <label
                for="name"
                class="block text-sm font-semibold text-gray-700 mb-2"
              >
                Nombre completo *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-sky-500 focus:ring-2 focus:ring-sky-200 transition-all outline-none"
                placeholder="Juan Pérez"
              />
            </div>

            <!-- Email -->
            <div>
              <label
                for="email"
                class="block text-sm font-semibold text-gray-700 mb-2"
              >
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-sky-500 focus:ring-2 focus:ring-sky-200 transition-all outline-none"
                placeholder="juan@ejemplo.com"
              />
            </div>
          </div>

          <!-- Grid para Phone y Investment Type -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Phone -->
            <div>
              <label
                for="phone"
                class="block text-sm font-semibold text-gray-700 mb-2"
              >
                Teléfono
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-sky-500 focus:ring-2 focus:ring-sky-200 transition-all outline-none"
                placeholder="+51 999-999-999"
              />
            </div>

            <!-- Investment Type -->
            <div>
              <label
                for="investment-type"
                class="block text-sm font-semibold text-gray-700 mb-2"
              >
                Tipo de inversión
              </label>
              <select
                id="investment-type"
                name="investment-type"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-sky-500 focus:ring-2 focus:ring-sky-200 transition-all outline-none bg-white"
              >
                <option value="">Selecciona una opción</option>
                <option value="residential">Residencial</option>
                <option value="multifamily">Multifamiliar</option>
                <option value="land">Terreno</option>
                <option value="commercial">Comercial</option>
                <option value="consultation">Consultoría</option>
              </select>
            </div>
          </div>

          <!-- Message -->
          <div>
            <label
              for="message"
              class="block text-sm font-semibold text-gray-700 mb-2"
            >
              Mensaje *
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="4"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-sky-500 focus:ring-2 focus:ring-sky-200 transition-all outline-none resize-none"
              placeholder="Cuéntanos sobre tus objetivos de inversión..."
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full bg-gradient-to-r from-sky-500 to-sky-600 text-white font-semibold py-4 rounded-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex items-center justify-center gap-2"
          >
            Enviar mensaje
            <i class="fa-solid fa-arrow-right"></i>
          </button>

          <!-- Success Message -->
          <div
            id="success-message"
            class="hidden bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg"
          >
            ¡Mensaje enviado! Nos pondremos en contacto pronto.
          </div>
        </form>
      </div>

      <!-- Contact Information -->
      <div class="space-y-8 xs:max-w-0">
        <!-- Info Cards -->
        <div class="grid gap-4">
          {
            contactInfo.map((info) => (
              <div class="px-4 py-1">
                {info.link ? (
                  <a href={info.link} class="flex items-center gap-3 group">
                    <i class={`fa-solid ${info.icon} text-sky-600 text-lg`} />
                    <p class="text-gray-600 font-medium">{info.value}</p>
                  </a>
                ) : (
                  <div class="flex items-center gap-3">
                    <i class={`fa-solid ${info.icon} text-sky-600 text-lg`} />
                    <p class="text-gray-600 font-medium">{info.value}</p>
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const successMessage = document.getElementById("success-message");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    // Simulate form submission
    setTimeout(() => {
      successMessage?.classList.remove("hidden");
      form.reset();

      // Hide success message after 5 seconds
      setTimeout(() => {
        successMessage?.classList.add("hidden");
      }, 5000);
    }, 500);
  });
</script>
