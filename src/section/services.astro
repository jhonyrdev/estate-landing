---
const services = [
  {
    icon: "fa-solid fa-building",
    title: "Inversión Residencial",
    description: "Propiedades residenciales cuidadosamente seleccionadas en zonas de alta demanda y crecimiento sostenido.",
    features: ["Alta plusvalía", "Ubicaciones premium", "ROI garantizado"]
  },
  {
    icon: "fa-solid fa-city",
    title: "Multifamiliares",
    description: "Edificios multifamiliares con flujo de ingresos constante y oportunidades de escalamiento.",
    features: ["Ingresos recurrentes", "Diversificación", "Gestión profesional"]
  },
  {
    icon: "fa-solid fa-chart-line",
    title: "Análisis de Mercado",
    description: "Estudios profundos del mercado inmobiliario para identificar las mejores oportunidades de inversión.",
    features: ["Data-driven", "Tendencias actuales", "Proyecciones precisas"]
  },
  {
    icon: "fa-solid fa-handshake",
    title: "Asesoría Personalizada",
    description: "Acompañamiento completo en cada paso de tu inversión inmobiliaria con expertos dedicados.",
    features: ["Atención 1-a-1", "Estrategia custom", "Soporte continuo"]
  }
];
---

<section id="servicios" class="mt-0 md:mt-20 py-15 bg-gradient-to-b from-white to-sky-100/80">
  <div class="container-personalizado mx-auto px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Soluciones Integrales de <span class="text-sky-700">Inversión</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Ofrecemos un portafolio completo de servicios diseñados para maximizar tu retorno de inversión
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {services.map((service, index) => (
        <article 
          class="service-card group relative bg-white rounded-3xl p-8 shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-100 hover:border-sky-300 overflow-hidden flex flex-col justify-center items-center"
          style={`animation-delay: ${index * 100}ms`}
        >
          <!-- Gradient overlay on hover -->
          <div class="absolute inset-0 bg-gradient-to-br from-sky-50 to-blue-50 opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"></div>
          
          <div class="service-card-content flex flex-col items-center justify-center h-full w-full">
            <!-- Icon -->
            <div class="icon-container flex items-center justify-center text-sky-600 text-3xl mb-6 group-hover:scale-110 transition-all duration-500">
              <i class={service.icon}></i>
            </div>

            <!-- Content -->
            <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-sky-700 transition-colors duration-300 text-center w-full">
              {service.title}
            </h3>
            
            <p class="text-gray-600 mb-6 leading-relaxed text-sm text-center w-full">
              {service.description}
            </p>

            <!-- Features -->
            <ul class="space-y-3 mb-6 w-full">
              {service.features.map((feature) => (
                <li class="flex items-start text-sm text-gray-700 justify-center">
                  <span class="flex-shrink-0 w-5 h-5 bg-sky-100 rounded-full flex items-center justify-center mr-3 mt-0.5 group-hover:bg-sky-200 transition-colors duration-300">
                    <i class="fa-solid fa-check text-sky-600 text-xs"></i>
                  </span>
                  <span class="flex-1">{feature}</span>
                </li>
              ))}
            </ul>

            <!-- Hover effect indicator -->
            <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-sky-400 to-blue-600 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
            
            <div class="flex items-center text-sky-600 font-semibold text-sm opacity-0 group-hover:opacity-100 transition-all duration-300 group-hover:translate-x-1">
              <span>Saber más</span>
              <i class="fa-solid fa-arrow-right ml-2 text-xs"></i>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA Section -->
    <div class="mt-10 text-center">
      <p class="text-gray-600 mb-6">¿Necesitas una solución personalizada?</p>
      <a 
        href="#contacto" 
        class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-sky-500 to-sky-600 text-white font-semibold md:rounded-full rounded-xl hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
      >
        Habla con un experto
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .service-card {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .service-card-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 100%;
  }

  .service-card:hover {
    transform: translateY(-8px);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .icon-container {
    position: relative;
  }
</style>
