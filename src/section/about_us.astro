---

---

<!-- About Section -->
<section id="nosotros" class="py-15 bg-sky-50/90">
  <div class="container-personalizado mx-auto px-8">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <!-- Image block -->
      <div class="relative">
        <!-- Organic image container -->
        <div class="relative overflow-hidden rounded-[3rem] shadow-2xl">
          <img
            src="./imgNosotros.jpg"
            alt="Asesor inmobiliario de EliteHome Invest en reunión con clientes, revisando oportunidades de inversión"
            class="w-full h-[480px] object-cover"
            loading="lazy"
          />
          <!-- Gradient overlay -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"
          >
          </div>
        </div>

        <!-- Experience badge -->
        <div
          class="absolute -bottom-0 -left-0 bg-white px-8 py-6 rounded-bl-[3rem]"
        >
          <p class="text-4xl font-bold text-sky-600">10+</p>
          <p class="text-sm text-gray-600 font-medium">años de experiencia</p>
        </div>

        <!-- Decorative element -->
        <div
          class="absolute -top-6 -right-6 w-32 h-32 bg-amber-100 rounded-full filter blur-2xl opacity-50 -z-10"
        >
        </div>
      </div>

      <!-- Content -->
      <div>
        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 leading-tight mb-6"
        >
          About Our <br />
          <span class="text-sky-600">EliteHome Invest</span>
        </h2>

        <p class="text-lg text-gray-600 leading-relaxed max-w-xl mb-8">
          EliteHome Invest es una iniciativa de inversión inmobiliaria con
          enfoque estratégico y disciplinado. Ayudamos a nuestros clientes a
          acceder a oportunidades sólidas en bienes raíces sin complejidad.
        </p>

        <!-- Features -->
        <div class="grid gap-6 sm:grid-cols-2 mb-10">
          <div class="bg-white p-6 rounded-xl border border-sky-100">
            <div class="flex items-center justify-center mb-4">
              <i class="fa-solid fa-chart-column text-sky-600 text-4xl"></i>
            </div>
            <h4 class="font-bold text-gray-900 mb-2">Strategic Focus</h4>
            <p class="text-sm text-gray-600">
              Inversión en propiedades residenciales y multifamiliares con alta
              demanda y crecimiento sostenido.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-indigo-100">
            <div class="flex items-center justify-center mb-4">
              <i class="fa-solid fa-circle-check text-indigo-600 text-4xl"></i>
            </div>
            <h4 class="font-bold text-gray-900 mb-2">Disciplined Approach</h4>
            <p class="text-sm text-gray-600">
              Selección basada en datos, análisis profundo y alianzas locales
              confiables.
            </p>
          </div>
        </div>

        <!-- CTA -->
        <div class="flex justify-center lg:justify-start">
          <a
            href="#contacto"
            class="inline-flex items-center md:rounded-full rounded-xl bg-gradient-to-r from-sky-500 to-sky-600 px-8 py-4 font-semibold text-white hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
          >
            Conocer más
            <i class="fa-solid fa-arrow-right ml-2"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
